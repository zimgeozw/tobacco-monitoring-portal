<FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
 SetHandler application/x-httpd-alt-php84-lsphp
</FilesMatch>

# TIMB Tobacco Crop Monitoring Portal - Designed by Zimgeo (www.zimgeo.co.zw)
# PHP 8.4 for this site only (the handler GreenGeeks uses; the portal needs PHP 8.1 or newer).
# Kept in Git so every cPanel deploy restores it - do not change PHP here via MultiPHP Manager.
<IfModule mime_module>
  AddHandler application/x-httpd-php84 .php
</IfModule>
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (requires the AutoSSL certificate on the subdomain)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Never serve internal folders or files
  RewriteRule ^(app|storage|sql|gee|\.git)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|README\.md|\.cpanel\.yml|\.user\.ini|\.gitignore)$ - [F,L]
</IfModule>

<FilesMatch "\.(md|yml|yaml|sql|log|ini|lock|gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/geo+json
</IfModule>
<FilesMatch "\.geojson$">
  ForceType application/geo+json
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
